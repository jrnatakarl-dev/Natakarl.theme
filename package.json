{
  "name": "natakarl-theme",
  "displayName": "Natakarl Theme",
  "description": "Tema escuro inspirado na identidade visual da Natakarl.",
  "version": "1.0.0",
  "publisher": "natakarl",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Natakarl",
        "uiTheme": "vs-dark",
        "path": "./themes/natakarl-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "editor.fontFamily": "'Victor Mono', monospace",
      "editor.fontLigatures": true
    }
  }
}
